---
// The reading-list layout (year grouping, bio line, hover summaries) is
// issue #12. This wires the shared tokens and container in place of it.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// postsLoader() only ever stores published posts - see
// apps/web/src/content/posts-loader.ts. listed: false still gets a page,
// just not a row here.
const listedPosts = await getCollection('posts', ({ data }) => data.listed);
const posts = listedPosts.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="publishd">
  <div class="measure mx-auto">
    <h1>publishd</h1>
    {
      posts.length === 0 ? (
        <p class="text-mute">Nothing published yet.</p>
      ) : (
        <ul class="list-none p-0">
          {posts.map((post) => (
            <li class="border-b border-border py-3">
              <a href={`/${post.data.slug}`}>{post.data.title}</a>
              <span class="text-mute text-[14px] font-[450]"> - {post.data.date}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
