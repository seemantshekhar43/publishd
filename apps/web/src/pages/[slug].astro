---
// The article furniture (heading anchors, footnotes, TOC, view
// transitions) is issue #13. This wires the shared tokens and prose
// container in place of it.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  // postsLoader() only ever stores published posts - see
  // apps/web/src/content/posts-loader.ts.
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
  <article class="measure mx-auto">
    <a href="/" class="text-mute">← home</a>
    <h1>{post.data.title}</h1>
    <p class="text-mute">{post.data.date}</p>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
