---
// The shared shell: tokens, type scale, the single-column reading
// container, and the theme toggle. Page-specific layout (the homepage
// list, the article furniture) lives in the pages that use this - see
// issues #12 and #13. See docs/design.md sections 2-5.
import { ClientRouter } from 'astro:transitions';
import '../styles/theme.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../../../../site.config.js';
import { resolveCanonicalUrl, absoluteUrl } from '../lib/seo.js';

interface Props {
  title: string;
  /** Falls back to the site bio when a page doesn't have its own. */
  description?: string;
  /** Falls back to the current URL, derived from `site.config.ts`. */
  canonicalUrl?: string;
  /** Falls back to `/og/default.png`. */
  ogImagePath?: string;
  ogType?: 'website' | 'article';
  /** Drafts only, per docs/PRD.md section 9.4 - see issue #18. */
  noindex?: boolean;
  /** One JSON-LD object, or several - a homepage carries both `Person` and
   * `WebSite`. */
  jsonLd?: object | object[];
}

const siteConfig = getSiteConfig();
const {
  title,
  description = siteConfig.bio,
  canonicalUrl = resolveCanonicalUrl(siteConfig, Astro.url.pathname),
  ogImagePath = '/og/default.png',
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<html lang="en" data-pagefind-ignore={noindex ? 'true' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Two variants, media-matched, so the OS-default case (no explicit
      choice) gets the right browser-chrome colour with no JS needed. The
      no-flash script below collapses these to one when an explicit choice
      overrides the OS preference. Values must stay in sync with the
      `--bg` token in theme.css - a literal here is unavoidable, since a
      CSS custom property cannot be read from a `<meta>` attribute.
    -->
    <meta name="theme-color" content="#FDFBF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F0E0C" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteUrl(siteConfig, ogImagePath)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(siteConfig, ogImagePath)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title={siteConfig.title} href="/feed.json" />

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <!--
      Astro's built-in view transitions - the single most "designed" thing
      on the site (docs/PRD.md section 9.6). It disables itself under
      `prefers-reduced-motion` on its own (see the media query in its own
      viewtransitions.css), so nothing extra is needed here for that.
    -->
    <ClientRouter />
    <!--
      The no-flash script. Render-blocking, and deliberately so - it is the
      only render-blocking JS on the site. It must run before first paint,
      inline, in <head>, ahead of the stylesheet that defines the tokens.
      Do not defer it, bundle it, move it to a <script> file, or add
      `is:inline` elsewhere without this same ordering. See
      docs/design.md section 5.
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
            var metas = document.querySelectorAll('meta[name="theme-color"]');
            metas.forEach(function (meta, index) {
              meta.removeAttribute('media');
              meta.setAttribute('content', stored === 'dark' ? '#0F0E0C' : '#FDFBF7');
              if (index > 0) meta.remove();
            });
          }
        } catch (e) {
          // localStorage unavailable - fall back to the OS preference,
          // which the CSS media query and the meta tags above already
          // handle without any JS.
        }
      })();
    </script>
  </head>
  <body>
    <header data-pagefind-ignore class="px-4 py-4">
      <div class="measure mx-auto flex items-center justify-between">
        <a href="/" class="font-heading text-[15px] font-semibold">{siteConfig.title}</a>
        <div class="flex items-center gap-1">
          <CommandPalette />
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main data-pagefind-body class="mx-auto px-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>
