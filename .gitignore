# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.astro/
.vercel/
.output/
coverage/

# Playwright run artifacts - visual/*-snapshots/ (committed baselines) are
# the exception, kept out of this glob by matching only the report/results
# dirs by name.
test-results/
playwright-report/
blob-report/
.lighthouseci/

# local review artifacts (inkloop sessions are local planning scratch)
.inkloop/

# local Claude Code session state
.claude/

# synced from the private content repo at build time - never committed here
apps/web/src/content/posts/*
!apps/web/src/content/posts/.gitkeep
apps/web/src/content/pages/*
!apps/web/src/content/pages/.gitkeep
apps/web/src/content/.lastmod.json
apps/web/src/content/redirects.json
apps/web/public/assets/*
!apps/web/public/assets/.gitkeep

# env + secrets
.env
.env.*
!.env.example

# os / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
