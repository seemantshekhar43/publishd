if ! command -v gitleaks >/dev/null 2>&1; then
  echo "error: gitleaks is not installed - see docs/development.md section 8" >&2
  echo "       install it with: brew install gitleaks" >&2
  exit 1
fi

gitleaks protect --staged --no-banner --redact
if [ $? -ne 0 ]; then
  echo "error: gitleaks found a likely secret in staged changes - see above" >&2
  echo "       if this is real, rotate it. it does not become safe once committed." >&2
  exit 1
fi

pnpm exec lint-staged
