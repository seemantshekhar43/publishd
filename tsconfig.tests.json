{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tests.tsbuildinfo"
  },
  "include": [
    "apps/*/src/**/*.test.ts",
    "apps/web/src/lib/**/*.ts",
    "e2e/**/*.ts",
    "apps/web/src/pages/api/**/*.ts",
    "packages/*/src/**/*.test.ts",
    "site.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "commitlint.config.js",
    "playwright.config.ts",
    "visual/**/*.ts"
  ],
  "references": [
    { "path": "packages/schema" },
    { "path": "apps/cli" },
    { "path": "tsconfig.site-config.json" }
  ]
}
